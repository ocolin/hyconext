{
    "name": "ocolin/hyconext",
    "description": "SNMP and SSH client for Hyconext switches",
    "keywords": ["snmp", "ssh", "hyconext", "network", "switch", "poe", "mac-table", "network-monitoring", "php"],
    "homepage": "https://github.com/ocolin/hyconext",
    "minimum-stability": "stable",
    "type": "library",
    "support": {
        "issues": "https://github.com/ocolin/hyconext/issues",
        "source": "https://github.com/ocolin/hyconext"
    },
    "require": {
        "ext-openssl": "*",
        "ext-gmp": "*",
        "php": "^8.4",
        "phpseclib/phpseclib": "^3.0",
        "ocolin/global-type": "^2.0",
        "ocolin/easysnmp": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "ocolin/easyenv": "^3.0",
        "phpstan/phpstan": "^2.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ocolin\\Hyconext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ocolin\\Hyconext\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Colin Miller",
            "email": "ocolin@cruzio.com"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage --display-deprecations --display-notices",
        "debug": "vendor/bin/phpunit --no-coverage --display-deprecations --display-notices --debug",
        "integration": "vendor/bin/phpunit --no-coverage --group integration",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html coverage"
    }
}
